  "type": "module",
  "description": "よむ: a small JPDB/Yomitan popup dictionary and subtitle miner userscript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HRussellZFAC023/kotoba-reader.git"
  },
  "bugs": {
    "url": "https://github.com/HRussellZFAC023/kotoba-reader/issues"
