      { "id": "fr-02", "text": "Elle a acheté du pain frais, deux pommes et une bouteille d'eau.", "contentWords": ["acheté", "pain", "frais", "deux", "pommes", "bouteille", "eau"] },
      { "id": "fr-03", "text": "Le vendeur l'a saluée et lui a demandé des nouvelles de sa famille.", "contentWords": ["vendeur", "saluée", "demandé", "nouvelles", "famille"] },
