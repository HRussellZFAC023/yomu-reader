{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "vite.config.ts",
    "vite.newtab.config.ts",
    "vite.size.config.ts",
    "src/reader/userscript-entry.ts",
    "src/reader/newtab-entry.ts",
    "scripts/qa-audit.mjs",
    "tests/reader/**/*.test.ts"
  ],
  "dynamicallyLoaded": [
    "src/reader/styles-reader.css",
    "src/reader/styles.css",
    "tests/reader/setup.ts",
    "public/newtab/sw.js",
    "scripts/uchisen-bulk-publish.mjs",
    "scripts/validate-uchisen-queue.mjs"
  ],
  "ignorePatterns": [
    "dist/**",
    "dist-dev/**",
    "docs/.vitepress/cache/**",
    "docs/public/newtab/**",
    "docs/public/yomu.css",
    "docs/public/yomu.user.js",
    "tests/reader/.vitest-*/**"
  ],
  "ignoreUnresolvedImports": [
    "./app.js",
    "../yomu.user.js",
    "./styles.css?v=__YOMU_NEW_TAB_CSS_HASH__"
  ],
  "ignoreExports": [
    {
      "file": "src/reader/card-utils.ts",
      "exports": ["*"]
    },
    {
      "file": "src/reader/new-tab.ts",
      "exports": ["*"]
    }
  ]
}
