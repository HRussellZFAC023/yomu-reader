    "sentences": [
      { "id": "fi-01", "text": "Maanantaina Maria meni aikaisin torille.", "contentWords": ["Maanantaina", "Maria", "meni", "aikaisin", "torille"] },
      { "id": "fi-02", "text": "Hän osti tuoretta leipää, kaksi omenaa ja pullon vettä.", "contentWords": ["osti", "tuoretta", "leipää", "kaksi", "omenaa", "pullon", "vettä"] },
      { "id": "fi-03", "text": "Myyjä tervehti häntä ja kysyi hänen perheestään.", "contentWords": ["Myyjä", "tervehti", "kysyi", "perheestään"] },
      { "id": "fi-04", "text": "Maria sanoi, että hänen lapsensa opiskelivat kotona.", "contentWords": ["Maria", "sanoi", "lapsensa", "opiskelivat", "kotona"] },
      { "id": "fi-05", "text": "Ostosten jälkeen hän käveli puiston läpi.", "contentWords": ["Ostosten", "käveli", "puiston"] },
      { "id": "fi-06", "text": "Pieni koira leikki järven lähellä.", "contentWords": ["Pieni", "koira", "leikki", "järven"] },
      { "id": "fi-07", "text": "Hän istui puun alle ja luki uuden kirjan.", "contentWords": ["istui", "puun", "luki", "uuden", "kirjan"] },
      { "id": "fi-08", "text": "Kun alkoi sataa, hän avasi sinisen sateenvarjonsa.", "contentWords": ["alkoi", "sataa", "avasi", "sinisen", "sateenvarjonsa"] },
      { "id": "fi-09", "text": "Hän palasi bussilla kotiin ennen päivällistä.", "contentWords": ["palasi", "bussilla", "kotiin", "päivällistä"] },
      { "id": "fi-10", "text": "Illalla koko perhe söi yhdessä ja puhui päivästä.", "contentWords": ["Illalla", "perhe", "söi", "yhdessä", "puhui", "päivästä"] }
    ]
