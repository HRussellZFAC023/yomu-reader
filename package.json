{
  "name": "yomu-reader",
  "version": "0.4.9",
  "private": true,
  "type": "module",
  "description": "よむ: a small JPDB/Yomitan popup dictionary and subtitle miner userscript.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HRussellZFAC023/yomu-reader.git"
  },
  "bugs": {
    "url": "https://github.com/HRussellZFAC023/yomu-reader/issues"
  },
  "homepage": "https://hrussellzfac023.github.io/yomu-reader/",
  "keywords": [
    "userscript",
    "jpdb",
    "yomitan",
    "japanese",
    "ocr",
    "subtitles",
    "tampermonkey"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && vite build --config vite.newtab.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-userscript.cjs",
    "smoke:subtitles": "node scripts/subtitle-player-smoke.mjs",
    "e2e:subtitles": "node scripts/subtitle-player-e2e.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify && node scripts/sync-docs-userscript.cjs && npm run docs:build",
    "docs": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "qa": "npm run check && node scripts/qa-audit.mjs && node scripts/docs-a11y-audit.mjs && node scripts/complexity-audit.mjs",
    "qa:live": "node scripts/jpdb-live-smoke.mjs",
    "publish:greasyfork": "node scripts/open-greasyfork-prefill.cjs"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@types/node": "^25.1.0",
    "axe-core": "^4.11.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.0.0",
    "playwright": "^1.56.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-monkey": "^3.5.1",
    "vitepress": "^1.6.4",
    "vitest": "^1.3.1"
  }
}
