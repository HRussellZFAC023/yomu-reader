{
  "name": "yomu-reader",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "よむ: a small JPDB/Yomitan popup dictionary and subtitle miner userscript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HRussellZFAC023/kotoba-reader.git"
  },
  "bugs": {
    "url": "https://github.com/HRussellZFAC023/kotoba-reader/issues"
  },
  "homepage": "https://hrussellzfac023.github.io/kotoba-reader/",
  "keywords": [
    "userscript",
    "jpdb",
    "yomitan",
    "japanese",
    "ocr",
    "subtitles",
    "tampermonkey"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:userscript && npm run docs:build",
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "qa:audit": "npm run build && node scripts/qa-audit.mjs",
    "qa:docs-a11y": "npm run docs:build && node scripts/docs-a11y-audit.mjs",
    "qa:complexity": "node scripts/complexity-audit.mjs",
    "qa:jpdb-live": "node scripts/jpdb-live-smoke.mjs",
    "qa:full": "npm run check && npm run qa:audit && npm run qa:docs-a11y && npm run qa:complexity",
    "prefill:greasyfork": "node scripts/open-greasyfork-prefill.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:userscript": "node scripts/verify-userscript.cjs"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@types/node": "^25.1.0",
    "axe-core": "^4.11.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.0.0",
    "playwright": "^1.56.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-monkey": "^3.5.1",
    "vitepress": "^1.6.4",
    "vitest": "^1.3.1"
  }
}
