    "sentences": [
      { "id": "sq-01", "text": "Të hënën, Maria shkoi herët në treg.", "contentWords": ["hënën", "Maria", "shkoi", "herët", "treg"] },
      { "id": "sq-02", "text": "Ajo bleu bukë të freskët, dy mollë dhe një shishe ujë.", "contentWords": ["bleu", "bukë", "freskët", "dy", "mollë", "shishe", "ujë"] },
      { "id": "sq-03", "text": "Shitësi e përshëndeti dhe e pyeti për familjen e saj.", "contentWords": ["Shitësi", "përshëndeti", "pyeti", "familjen"] },
      { "id": "sq-04", "text": "Maria tha se fëmijët e saj po mësonin në shtëpi.", "contentWords": ["Maria", "tha", "fëmijët", "mësonin", "shtëpi"] },
      { "id": "sq-05", "text": "Pas blerjeve, ajo kaloi nëpër park.", "contentWords": ["blerjeve", "kaloi", "park"] },
      { "id": "sq-06", "text": "Një qen i vogël po luante pranë liqenit.", "contentWords": ["qen", "vogël", "luante", "liqenit"] },
      { "id": "sq-07", "text": "Ajo u ul nën një pemë dhe lexoi një libër të ri.", "contentWords": ["ul", "pemë", "lexoi", "libër", "ri"] },
      { "id": "sq-08", "text": "Kur filloi shiu, ajo hapi çadrën e kaltër.", "contentWords": ["filloi", "shiu", "hapi", "çadrën", "kaltër"] },
      { "id": "sq-09", "text": "Para darkës, ajo u kthye në shtëpi me autobus.", "contentWords": ["darkës", "kthye", "shtëpi", "autobus"] },
      { "id": "sq-10", "text": "Në mbrëmje, e gjithë familja hëngri së bashku dhe foli për ditën.", "contentWords": ["mbrëmje", "familja", "hëngri", "bashku", "foli", "ditën"] }
    ]
  },
  {
    "language": "grc",
    "source": {
