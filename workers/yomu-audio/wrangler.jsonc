{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yomu-audio",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "audio.yomureader.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "AUDIO_MANIFEST_KEY": "index/audio-index.json",
    "AUDIO_INDEX_PREFIX": "index/v2/shards",
    "AUDIO_DISABLED": "false",
    "AUDIO_ANALYTICS_LOGS": "false"
  },
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "yomu-audio"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
