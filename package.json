{
  "name": "yomu-reader",
  "version": "1.6.99",
  "private": true,
  "type": "module",
  "description": "よむ: a small Jiten/JPDB/Yomitan popup dictionary and subtitle miner userscript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HRussellZFAC023/yomu-reader.git"
  },
  "bugs": {
    "url": "https://github.com/HRussellZFAC023/yomu-reader/issues"
  },
  "homepage": "https://yomureader.com/",
  "keywords": [
    "userscript",
    "jpdb",
    "jiten",
    "yomitan",
    "japanese",
    "ocr",
    "subtitles",
    "tampermonkey"
  ],
  "yomu": {
    "allowedRequireUrls": [
      "https://yomureader.com/greasyfork/yomu-anki.user.js",
      "https://yomureader.com/greasyfork/yomu-kanji-study.user.js",
      "https://yomureader.com/greasyfork/yomu-settings-surface.user.js",
      "https://yomureader.com/greasyfork/yomu-video.user.js"
    ]
  },
  "scripts": {
    "audio:export": "node scripts/export-yomu-audio-from-local.mjs",
    "build": "npm run build:userscript",
    "build:extension": "npm run build:userscript:self-contained && node scripts/build-extension.mjs",
    "build:gaming": "npm run build:gaming:renderer && npm run build:gaming:main",
    "build:gaming:icon": "node scripts/generate-gaming-icon.mjs",
    "build:gaming:main": "node scripts/build-gaming-electron.mjs",
    "build:gaming:renderer": "vite build --config config/vite/gaming.config.ts",
    "build:userscript": "vite build && node scripts/build-reader-css.mjs && vite build --config config/vite/newtab.config.ts && node scripts/build-greasyfork-libraries.mjs && node scripts/format-userscript-css.cjs && node scripts/annotate-userscript-compliance.cjs && node scripts/trim-userscript-indent.cjs && node scripts/annotate-greasyfork-requires.cjs",
    "build:userscript:self-contained": "YOMU_USERSCRIPT_BUNDLE_MODE=self-contained vite build && node scripts/build-reader-css.mjs && vite build --config config/vite/newtab.config.ts && node scripts/format-userscript-css.cjs && node scripts/annotate-userscript-compliance.cjs",
    "check": "npm run typecheck && npm run test:ci && npm run build && node scripts/sync-docs-userscript.cjs && npm run docs:build && npm run verify",
    "dev": "node scripts/dev-userscript.mjs",
    "dev:gaming": "node scripts/dev-gaming-app.mjs",
    "dev:ipad": "node scripts/dev-ipad.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "docs": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "node scripts/check-public-docs.mjs && vitepress build docs",
    "e2e:subtitles": "node scripts/subtitle-player-e2e.mjs",
    "fallow": "fallow",
    "fallow:audit": "git diff --unified=0 --no-ext-diff ${FALLOW_BASE:-origin/main} -- . | fallow audit --format compact --base ${FALLOW_BASE:-origin/main} --diff-stdin",
    "fallow:dead-code": "fallow dead-code --format compact --fail-on-issues",
    "fixture:mokuro": "node scripts/lib/build-mokuro-fixture.mjs",
    "profile:performance": "node scripts/profile-performance.mjs",
    "package:gaming": "npm run smoke:gaming && node scripts/package-gaming-electron.mjs --target=dir",
    "qa": "npm run check && npm run smoke:p0 && node scripts/qa-audit.mjs && node scripts/docs-a11y-audit.mjs && node scripts/complexity-audit.mjs",
    "qa:live": "node scripts/jpdb-live-smoke.mjs",
    "release:gaming": "npm run prepare:electron && npm run build:gaming && node scripts/package-gaming-electron.mjs",
    "release:gaming:linux": "npm run prepare:electron && npm run build:gaming && node scripts/package-gaming-electron.mjs --platform=linux --arch=x64 --target=AppImage",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "screenshots:real": "node scripts/capture-real-screenshots.mjs",
    "size:bundle": "node scripts/bundle-size-report.mjs",
    "size:greasyfork-plan": "npm run build && npm run size:modules && node scripts/greasyfork-size-plan.mjs",
    "size:modules": "vite build --config config/vite/size.config.ts",
    "smoke:bookwalker-apex-ocr": "node scripts/bookwalker-apex-ocr-smoke.mjs",
    "smoke:bookwalker-modes-ocr": "node scripts/bookwalker-modes-ocr-smoke.mjs",
    "smoke:bookwalker-cty2-scroll": "node scripts/bookwalker-cty2-scroll-smoke.mjs",
    "smoke:bookwalker-tap-passthrough": "node scripts/bookwalker-tap-passthrough-smoke.mjs",
    "smoke:bookwalker-tap-retry": "node scripts/bookwalker-tap-retry-smoke.mjs",
    "smoke:overlay-scroll-lock": "node scripts/overlay-scroll-lock-smoke.mjs",
    "smoke:passive-decoration": "node scripts/passive-decoration-smoke.mjs",
    "smoke:anki": "node scripts/anki-mining-smoke.mjs",
    "smoke:anki-template": "node scripts/anki-template-render-smoke.mjs",
    "smoke:anki-wikipedia": "node scripts/anki-wikipedia-smoke.mjs",
    "smoke:audio-csp-fallback": "node scripts/audio-csp-fallback-smoke.mjs",
    "smoke:audio-real-page": "node scripts/audio-real-page-smoke.mjs",
    "smoke:bookwalker-carousel": "node scripts/bookwalker-carousel-overflow-smoke.mjs",
    "smoke:bunpro-live": "node scripts/bunpro-live-smoke.mjs",
    "smoke:audio-newtab": "node scripts/audio-newtab-smoke.mjs",
    "smoke:audio-popover": "node scripts/audio-popover-smoke.mjs",
    "smoke:compact-chrome": "node scripts/compact-interactive-chrome-smoke.mjs",
    "smoke:feedback": "node scripts/feedback-smoke.mjs",
    "prepare:electron": "node scripts/ensure-electron-runtime.mjs",
    "smoke:gaming": "npm run prepare:electron && npm run build:gaming && node scripts/gaming-app-smoke.mjs",
    "smoke:hosted-settings": "node scripts/hosted-settings-self-enhancement-smoke.mjs",
    "smoke:jiten-newtab": "node scripts/jiten-newtab-smoke.mjs",
    "smoke:jiten-keyless-definition": "node scripts/jiten-keyless-definition-smoke.mjs",
    "smoke:japanese-sites": "node scripts/japanese-site-language-smoke.mjs",
    "smoke:keyless-jiten-detail": "node scripts/keyless-jiten-detail-smoke.mjs",
    "smoke:onboarding-popover": "node scripts/onboarding-popover-smoke.mjs",
    "smoke:furigana-local-default": "node scripts/furigana-local-default-smoke.mjs",
    "smoke:definition-sources": "node scripts/definition-sources-playwright-smoke.mjs",
    "smoke:keyless-popover": "node scripts/keyless-word-popover-smoke.mjs",
    "smoke:late-content": "node scripts/late-content-smoke.mjs",
    "smoke:grading-provider": "node scripts/grading-provider-popover-smoke.mjs",
    "smoke:google-search-reader": "node scripts/google-search-reader-smoke.mjs",
    "smoke:live-browser": "node scripts/live-browser-smoke.mjs",
    "smoke:mobile-docs": "node scripts/mobile-docs-regression-smoke.mjs",
    "smoke:newtab-recall": "node scripts/newtab-recall-smoke.mjs",
    "smoke:newtab-study-underline": "node scripts/newtab-study-underline-smoke.mjs",
    "smoke:offline-study": "node scripts/offline-study-smoke.mjs",
    "smoke:listen-mode": "node scripts/listen-mode-smoke.mjs",
    "smoke:ocr-provider-matrix": "node scripts/ocr-provider-matrix.mjs",
    "smoke:p0": "npm run smoke:feedback && npm run smoke:pdf-reader && npm run smoke:google-search-reader",
    "smoke:youtube-sidebar-layout": "node scripts/youtube-sidebar-layout-matrix.mjs",
    "smoke:youtube-sidebar-resize-profile": "node scripts/youtube-sidebar-resize-profile.mjs",
    "smoke:popover-headword-furigana": "node scripts/popover-headword-furigana-smoke.mjs",
    "smoke:popover-actions": "node scripts/popover-action-pills-smoke.mjs",
    "smoke:youtube-performance": "node scripts/youtube-performance-profile.mjs",
    "smoke:youtube-ruby-proof": "node scripts/youtube-ruby-coverage-proof.mjs",
    "smoke:youtube-title-recycler": "node scripts/youtube-title-recycler-smoke.mjs",
    "smoke:enhancement-coverage": "node scripts/enhancement-coverage-smoke.mjs",
    "smoke:enrichment-concurrency": "node scripts/enrichment-concurrency-smoke.mjs",
    "smoke:youtube-shorts-skip": "node scripts/youtube-shorts-skip-smoke.mjs",
    "smoke:pitch-underline": "node scripts/pitch-underline-smoke.mjs",
    "smoke:underline-baseline": "node scripts/underline-baseline-smoke.mjs",
    "smoke:pdf-reader": "node scripts/pdf-reader-smoke.mjs",
    "smoke:reader-sites": "node scripts/reader-sites-smoke.mjs",
    "smoke:settings-layout": "node scripts/settings-layout-smoke.mjs",
    "smoke:subtitle-live-sites": "node scripts/subtitle-live-video-site-smoke.mjs",
    "smoke:subtitle-live-compat": "YOMU_LIVE_VIDEO_SITE_SET=compat node scripts/subtitle-live-video-site-smoke.mjs",
    "smoke:study-personas": "node scripts/study-personas-smoke.mjs",
    "smoke:study-flow-stability": "node scripts/study-flow-stability-smoke.mjs",
    "smoke:subtitles": "node scripts/subtitle-player-smoke.mjs",
    "smoke:youtube": "node scripts/youtube-feature-smoke.mjs",
    "smoke:youtube-auto-translation": "node scripts/youtube-auto-translation-smoke.mjs",
    "smoke:youtube-controls-wake": "node scripts/youtube-controls-wake-smoke.mjs",
    "smoke:extension-boot": "node scripts/extension-boot-smoke.mjs",
    "smoke:youtube-dom-safe": "node scripts/youtube-dom-safe-smoke.mjs",
    "smoke:youtube-fullscreen": "node scripts/youtube-fullscreen-smoke.mjs",
    "smoke:youtube-homepage-performance": "node scripts/youtube-homepage-performance-profile.mjs",
    "smoke:youtube-real-dom-instability": "node scripts/youtube-real-dom-instability-smoke.mjs",
    "test": "vitest run",
    "test:ci": "node scripts/run-ci-suite.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-userscript.cjs",
    "start:gaming": "npm run build:gaming && electron dist-gaming/electron/main.cjs",
    "smoke:constrained-gate": "node scripts/constrained-row-mirror-gate-smoke.mjs",
    "smoke:chip-mirror": "node scripts/chip-mirror-fidelity-smoke.mjs",
    "smoke:live-furigana-layout": "node scripts/live-furigana-layout-smoke.mjs",
    "smoke:lookup-popover-strip": "node scripts/lookup-popover-strip-smoke.mjs",
    "smoke:transcript-drawer": "node scripts/transcript-drawer-row-smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@electron/packager": "^18.4.4",
    "@types/node": "^25.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.5",
    "fake-indexeddb": "^6.2.5",
    "fallow": "^2.88.3",
    "jsdom": "^24.0.0",
    "playwright": "^1.56.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-monkey": "^3.5.1",
    "vitepress": "^1.6.4",
    "vitest": "^1.3.1",
    "vue": "^3.5.34"
  }
}
