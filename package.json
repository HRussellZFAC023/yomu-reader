{
  "name": "yomu-reader",
  "version": "0.6.15",
  "private": true,
  "type": "module",
  "description": "よむ: a small JPDB/Yomitan popup dictionary and subtitle miner userscript.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HRussellZFAC023/yomu-reader.git"
  },
  "bugs": {
    "url": "https://github.com/HRussellZFAC023/yomu-reader/issues"
  },
  "homepage": "https://hrussellzfac023.github.io/yomu-reader/",
  "keywords": [
    "userscript",
    "jpdb",
    "yomitan",
    "japanese",
    "ocr",
    "subtitles",
    "tampermonkey"
  ],
  "scripts": {
    "dev": "node scripts/dev-userscript.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:ipad": "node scripts/dev-ipad.mjs",
    "build": "vite build && node scripts/build-reader-css.mjs && vite build --config vite.newtab.config.ts && node scripts/format-userscript-css.cjs && node scripts/annotate-userscript-compliance.cjs && node scripts/compact-userscript-whitespace.cjs",
    "build:extension": "npm run build && node scripts/build-extension.mjs",
    "test": "vitest run",
    "test:ci": "node scripts/run-ci-suite.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-userscript.cjs",
    "smoke:anki": "node scripts/anki-mining-smoke.mjs",
    "smoke:anki-wikipedia": "node scripts/anki-wikipedia-smoke.mjs",
    "smoke:anki-template": "node scripts/anki-template-render-smoke.mjs",
    "smoke:feedback": "node scripts/feedback-smoke.mjs",
    "smoke:live-browser": "node scripts/live-browser-smoke.mjs",
    "smoke:subtitles": "node scripts/subtitle-player-smoke.mjs",
    "e2e:subtitles": "node scripts/subtitle-player-e2e.mjs",
    "check": "npm run typecheck && npm run test:ci && npm run build && npm run verify && node scripts/sync-docs-userscript.cjs && npm run docs:build",
    "docs": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "qa": "npm run check && node scripts/qa-audit.mjs && node scripts/docs-a11y-audit.mjs && node scripts/complexity-audit.mjs",
    "qa:live": "node scripts/jpdb-live-smoke.mjs",
    "size:bundle": "node scripts/bundle-size-report.mjs",
    "size:modules": "vite build --config vite.size.config.ts",
    "publish:greasyfork": "node scripts/open-greasyfork-prefill.cjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@types/node": "^25.1.0",
    "axe-core": "^4.11.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.0.0",
    "playwright": "^1.56.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-monkey": "^3.5.1",
    "vitepress": "^1.6.4",
    "vitest": "^1.3.1"
  }
}
