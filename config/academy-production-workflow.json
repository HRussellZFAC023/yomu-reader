{
  "schema": "yomu-academy.production-workflow/v2",
  "canonicalBacklog": "docs/academy/BACKLOG.md",
  "maxParallel": 6,
  "exclusiveFileReservations": true,
  "claimTtlHours": 12,
  "proofMaxAgeMinutes": 120,
  "proofCommandMaxOutputBytes": 4194304,
  "requiredReviewProvider": "claude-fable",
  "reviewProviders": {
    "claude-fable": {
      "reviewerId": "claude-fable",
      "toolId": "claude-code-fable",
      "model": "claude-fable-5",
      "serviceProvenance": "unresolved"
    }
  },
  "approvalPolicies": {
    "owner": {
      "requiredKeyIds": ["heru-github-ed25519-2026-07"]
    }
  },
  "trustedGateProducers": {
    "workflow": ["academy-production-workflow"],
    "ci": ["github-actions"]
  },
  "externalRoots": {
    "japaneseLibrary": {
      "env": "YOMU_JAPANESE_ROOT",
      "default": "/Users/heru/Documents/Japanese"
    },
    "soyaResearch": {
      "env": "YOMU_SOYA_ROOT",
      "default": "/Users/heru/Documents/Projects/yomu/references/soya-research"
    }
  },
  "reuse": {
    "transcriptIndexMaxAgeHours": 24,
    "transcriptRoots": {
      "claude": {
        "env": "YOMU_CLAUDE_TRANSCRIPTS",
        "default": "/Users/heru/.claude/projects"
      },
      "codex": {
        "env": "YOMU_CODEX_TRANSCRIPTS",
        "default": "/Users/heru/.codex/sessions"
      }
    },
    "evidenceFiles": [
      "docs/academy/SALVAGE-LEDGER.md",
      "docs/academy/story/SALVAGE-LEDGER.md",
      "docs/academy/provenance/CLAUDE-RECOVERY-20260718.md",
      "docs/academy/SESSION-LOG.md",
      "docs/academy/recovery/PLAYABLE-WEEK-DEPTH-AUDIT.md",
      "docs/academy/recovery/REMAINING-CURRICULUM-COMPLETION-MATRIX.md",
      "docs/academy/recovery/ASSET-CARRYOVER.json",
      "docs/academy/recovery/RECOVERED-ART-MANIFEST.json"
    ]
  },
  "routeCensus": [
    {
      "id": "lesson-content-files",
      "kind": "directory-files",
      "path": "public/academy/content/lessons",
      "include": "\\.json$",
      "claim": "Published lesson-content files; this is not a learner-reachability claim."
    },
    {
      "id": "story-chapter-sources",
      "kind": "directory-files",
      "path": "src/academy/content/story-sources",
      "include": "^s[1-4]e[0-9]{2}-.+\\.v2\\.json$",
      "claim": "Canonical authored chapter sources; runtime reachability is reported separately by proof gate R."
    },
    {
      "id": "world-place-routes",
      "kind": "typescript-object-ids",
      "path": "src/academy/domain/world-locations.ts",
      "start": "const WORLD_PLACES:",
      "end": "const PLACE_BY_ID",
      "idPattern": "^ {8}id: '([^']+)'",
      "claim": "Runtime-registered World place identifiers."
    }
  ],
  "sectionPriorities": {
    "Games and varied practice catalogue": "P1",
    "Platform, operations and release": "P0"
  },
  "currentFocus": [
    "GOV-001",
    "QA-001",
    "QA-006",
    "CUR-013",
    "CUR-014",
    "N1P-001",
    "PED-001",
    "STO-001",
    "AUD-002",
    "AUD-003",
    "PLAT-001",
    "REL-001"
  ],
  "dynamicDependencies": {
    "REL-001": {
      "kind": "release-scope",
      "description": "All open P0 tasks plus P1 tasks explicitly selected for this release must be complete.",
      "excludePrefixes": ["REL"],
      "releaseTargetedP1": []
    }
  },
  "proofGates": {
    "C": "Canonical production code or content exists, with no parallel demo truth.",
    "R": "The result is reachable through the real product route.",
    "T": "Focused automated tests and validators pass.",
    "Q": "Real-app QA covers applicable viewports, inputs, accessibility, and reduced motion.",
    "S": "Source, licence, attribution, consent, privacy, and secret boundaries are recorded.",
    "O": "Denominators and learner evidence derive from canonical data.",
    "D": "Hosted assets, backend state, docs, and production smoke agree."
  },
  "release": {
    "integrationCapacity": 1,
    "checkpointAfterPromotions": 1,
    "pushEveryCheckpoint": true,
    "publishUserVisibleSlices": true,
    "userVisiblePrefixes": [
      "CUR", "N1P", "ASSESS", "SKILL", "KAN", "PED", "MET", "SRS", "STO", "CAST",
      "WORLD", "SYS", "AUD", "ART", "VIS", "GAM", "XYM", "PLAT", "QA", "REL"
    ],
    "preCommitCommands": [
      "git diff --check",
      "npm run check:quick"
    ],
    "preReleaseCommands": [
      "npm run release:preflight",
      "npm run gate:academy-release"
    ]
  },
  "lanes": [
    {
      "id": "governance",
      "prefixes": ["BASE", "GOV", "OPS"],
      "capacity": 1,
      "agentClass": "architecture",
      "checkout": "worktree",
      "ownership": [
        "config/academy-production-workflow.json",
        "docs/academy/**",
        "package.json",
        "scripts/academy-*.mjs",
        "scripts/lib/academy-workflow-*.mjs",
        "scripts/lib/academy-workflow-*.d.mts",
        "tests/academy/**"
      ]
    },
    {
      "id": "stability",
      "prefixes": ["QA", "REL"],
      "capacity": 1,
      "agentClass": "verification",
      "checkout": "worktree",
      "ownership": [
        "src/**", "tests/**", "scripts/**", ".github/**", "docs/**",
        "CHANGELOG.md", "package.json", "package-lock.json", "dist/**"
      ]
    },
    {
      "id": "curriculum",
      "prefixes": ["CUR", "N1P", "ASSESS", "SKILL", "KAN"],
      "capacity": 2,
      "agentClass": "pedagogy-and-code",
      "checkout": "worktree",
      "ownership": ["src/academy/content/**", "src/academy/assessment/**", "public/academy/content/**", "scripts/academy-source-*.mjs", "tests/academy/**", "docs/academy/**"]
    },
    {
      "id": "learning-design",
      "prefixes": ["PED", "MET", "SRS"],
      "capacity": 1,
      "agentClass": "learning-science",
      "checkout": "worktree",
      "ownership": ["src/academy/**", "tests/academy/**", "docs/academy/**"]
    },
    {
      "id": "story-world",
      "prefixes": ["STO", "CAST", "WORLD", "SYS"],
      "capacity": 2,
      "agentClass": "narrative-and-runtime",
      "checkout": "worktree",
      "ownership": ["src/academy/content/story-sources/**", "src/academy/world/**", "src/academy/story/**", "tests/academy/**", "docs/academy/story/**"]
    },
    {
      "id": "audio",
      "prefixes": ["AUD"],
      "capacity": 2,
      "agentClass": "audio-production",
      "checkout": "worktree",
      "ownership": ["src/academy/audio/**", "scripts/academy-voice/**", "public/academy/audio/**", "docs/academy/audio/**", "tests/academy/**"]
    },
    {
      "id": "visual",
      "prefixes": ["ART", "VIS"],
      "capacity": 2,
      "agentClass": "visual-production",
      "checkout": "worktree",
      "ownership": [
        "src/academy/ui/**",
        "src/academy/styles/**",
        "src/academy/assets.ts",
        "src/academy/assets/**",
        "public/academy/art/**",
        "docs/academy/art/**",
        "docs/academy/art-review/**",
        "docs/academy/recovery/**",
        "scripts/academy-asset-*.mjs",
        "tests/academy/**"
      ]
    },
    {
      "id": "games-and-yomu",
      "prefixes": ["GAM", "XYM"],
      "capacity": 2,
      "agentClass": "gameplay-integration",
      "checkout": "worktree",
      "ownership": ["src/academy/minigames/**", "src/academy/reader-bridge/**", "src/academy/watch/**", "tests/academy/**", "docs/academy/**"]
    },
    {
      "id": "platform",
      "prefixes": ["PLAT"],
      "capacity": 1,
      "agentClass": "backend-and-security",
      "checkout": "worktree",
      "ownership": [
        "src/academy/worker/**",
        "src/academy/account/**",
        "src/academy/access/donation-checkout.ts",
        "src/academy/access/donation-claim.ts",
        "src/academy/access/gateway.ts",
        "src/academy/access/local-qa.ts",
        "src/academy/app.ts",
        "src/academy/ui/access-screen.ts",
        "workers/yomu-academy/**",
        "wrangler.academy.jsonc",
        "migrations/**",
        "tests/academy/**",
        "docs/academy/**"
      ]
    },
    {
      "id": "documentation",
      "prefixes": ["DOC"],
      "capacity": 1,
      "agentClass": "documentation",
      "checkout": "worktree",
      "ownership": ["docs/**", "scripts/check-universe-wiki.mjs", "tests/academy/**"]
    }
  ]
}
