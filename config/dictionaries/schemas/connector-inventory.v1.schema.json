{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dictionaries.yomureader.com/schemas/connector-inventory.v1.schema.json",
  "title": "Verified dictionary connector inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotRevision", "expectedEntryCount", "redistributionRightsConfirmed", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotRevision": { "type": "string", "minLength": 1 },
    "expectedEntryCount": { "const": 173 },
    "redistributionRightsConfirmed": { "const": true },
    "entries": {
      "type": "array",
      "minItems": 173,
      "maxItems": 173,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalogId",
          "sourceId",
          "title",
          "version",
          "categories",
          "headwordLanguages",
          "definitionLanguages",
          "sourceUrl",
          "attribution"
        ],
        "properties": {
          "catalogId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "sourceId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "terms",
                "names",
                "grammar",
                "kanji",
                "frequency",
                "pronunciation",
                "examples",
                "thesaurus",
                "encyclopedia",
                "utility"
              ]
            }
          },
          "headwordLanguages": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "definitionLanguages": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "projectUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "catalogueSection": { "type": "string", "minLength": 1 },
          "attribution": { "type": "string", "minLength": 1 },
          "licenseSpdx": { "type": ["string", "null"] },
          "licenseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "object": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "sha256", "bytes", "contentType"],
            "properties": {
              "key": { "type": "string", "pattern": "^objects/sha256/[a-f0-9]{64}\\.zip$" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "bytes": { "type": "integer", "minimum": 1 },
              "contentType": { "const": "application/zip" }
            }
          }
        }
      }
    }
  }
}
