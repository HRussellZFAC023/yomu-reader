{
  "name": "yomu-reader",
  "version": "1.6.172",
  "private": true,
  "type": "module",
  "description": "よむ: a Jiten/Bunpro/JPDB/Yomitan popup dictionary, study, and subtitle-mining userscript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HRussellZFAC023/yomu-reader.git"
  },
  "bugs": {
    "url": "https://github.com/HRussellZFAC023/yomu-reader/issues"
  },
  "homepage": "https://yomureader.com/",
  "keywords": [
    "userscript",
    "jpdb",
    "jiten",
    "yomitan",
    "japanese",
    "ocr",
    "subtitles",
    "tampermonkey"
  ],
  "yomu": {
    "allowedRequireUrls": [
      "https://yomureader.com/greasyfork/yomu-anki.user.js",
      "https://yomureader.com/greasyfork/yomu-kanji-study.user.js",
      "https://yomureader.com/greasyfork/yomu-settings-surface.user.js",
      "https://yomureader.com/greasyfork/yomu-video.user.js"
    ]
  },
  "scripts": {
    "audio:export": "node scripts/export-yomu-audio-from-local.mjs",
    "build:academy": "npm run academy:lessons:validate && vite build --config config/vite/academy.config.ts && node scripts/sync-academy.cjs",
    "gate:academy-release": "node scripts/academy-release-gate.mjs",
    "build": "npm run build:userscript",
    "build:extension": "npm run build:userscript:self-contained && node scripts/build-extension.mjs",
    "build:gaming": "npm run build:gaming:renderer && npm run build:gaming:main",
    "build:gaming:icon": "node scripts/generate-gaming-icon.mjs",
    "build:gaming:main": "node scripts/build-gaming-electron.mjs",
    "build:gaming:renderer": "vite build --config config/vite/gaming.config.ts",
    "build:userscript": "vite build && node scripts/build-reader-css.mjs && vite build --config config/vite/newtab.config.ts && node scripts/build-greasyfork-libraries.mjs && node scripts/format-userscript-css.cjs && node scripts/annotate-userscript-compliance.cjs && node scripts/trim-userscript-indent.cjs && node scripts/annotate-greasyfork-requires.cjs",
    "build:userscript:self-contained": "YOMU_USERSCRIPT_BUNDLE_MODE=self-contained vite build && node scripts/build-reader-css.mjs && vite build --config config/vite/newtab.config.ts && node scripts/format-userscript-css.cjs && node scripts/annotate-userscript-compliance.cjs",
    "check": "npm run typecheck && npm run test:ci && npm run test:academy && npm run build && node scripts/sync-docs-userscript.cjs && npm run build:academy && npm run docs:build && npm run verify",
    "check:academy": "npm run typecheck && npm run test:academy && npm run academy:source:validate && npm run build:academy",
    "academy:source:census": "node scripts/academy-source-pipeline.mjs census",
    "academy:source:pipeline": "node scripts/academy-source-pipeline.mjs all",
    "academy:audio:catalog": "node scripts/academy-audio-source-catalog.mjs",
    "academy:listening:assets": "node scripts/academy-listening-assets.mjs",
    "academy:listening:bindings": "node scripts/academy-listening-task-bindings.mjs",
    "academy:source:validate": "node scripts/academy-source-pipeline.mjs validate && node scripts/academy-library-pipeline.mjs validate && npm run academy:corpus:validate",
    "academy:corpus:build": "node scripts/academy-permitted-corpus.mjs build",
    "academy:corpus:validate": "node scripts/academy-permitted-corpus.mjs validate",
    "academy:library:scan": "node scripts/academy-library-pipeline.mjs scan",
    "academy:library:census": "node scripts/academy-library-pipeline.mjs census",
    "academy:library:pipeline": "node scripts/academy-library-pipeline.mjs all",
    "academy:library:validate": "node scripts/academy-library-pipeline.mjs validate",
    "academy:lessons:validate": "vitest run --config config/vite/academy.config.ts tests/academy/all-lessons-grounded.test.ts tests/academy/lesson-pedagogy-conformance.test.ts tests/academy/resource-ledger-honesty.test.ts",
    "dev": "node scripts/dev-userscript.mjs",
    "dev:gaming": "node scripts/dev-gaming-app.mjs",
    "dev:academy": "vite --config config/vite/academy.config.ts",
    "dev:ipad": "node scripts/dev-ipad.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "docs": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "node scripts/check-public-docs.mjs && vitepress build docs",
    "manual:subtitles-e2e": "node scripts/manual/subtitle-player-e2e.mjs",
    "favicons:generate": "node scripts/generate-favicons.mjs",
    "fallow": "fallow",
    "fallow:audit": "git diff --unified=0 --no-ext-diff ${FALLOW_BASE:-origin/main} -- . | fallow audit --format compact --base ${FALLOW_BASE:-origin/main} --diff-stdin",
    "fallow:dead-code": "fallow dead-code --format compact --fail-on-issues",
    "fixture:mokuro": "node scripts/lib/build-mokuro-fixture.mjs",
    "profile:performance": "node scripts/profile-performance.mjs",
    "package:gaming": "npm run smoke:gaming && node scripts/package-gaming-electron.mjs --target=dir",
    "qa": "npm run check && npm run smoke:p0 && node scripts/qa-audit.mjs && node scripts/docs-a11y-audit.mjs && node scripts/complexity-audit.mjs",
    "manual:jpdb-live": "node scripts/manual/jpdb-live-smoke.mjs",
    "release:preflight": "npm run check && npm run smoke:release && npm run smoke:gaming",
    "release:gaming": "npm run prepare:electron && npm run build:gaming && node scripts/package-gaming-electron.mjs",
    "release:gaming:linux": "npm run prepare:electron && npm run build:gaming && node scripts/package-gaming-electron.mjs --platform=linux --arch=x64 --target=AppImage",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "manual:screenshots-real": "node scripts/manual/capture-real-screenshots.mjs",
    "size:bundle": "node scripts/bundle-size-report.mjs",
    "size:greasyfork-plan": "npm run build && npm run size:modules && node scripts/greasyfork-size-plan.mjs",
    "size:modules": "vite build --config config/vite/size.config.ts",
    "smoke:bookwalker-modes-ocr": "node scripts/bookwalker-modes-ocr-smoke.mjs",
    "smoke:bookwalker-cty2-scroll": "node scripts/bookwalker-cty2-scroll-smoke.mjs",
    "manual:bookwalker-live-firefox": "node scripts/manual/bookwalker-live-firefox-smoke.mjs",
    "smoke:bookwalker-tap-passthrough": "node scripts/bookwalker-tap-passthrough-smoke.mjs",
    "smoke:bookwalker-tap-retry": "node scripts/bookwalker-tap-retry-smoke.mjs",
    "manual:overlay-scroll-lock": "node scripts/manual/overlay-scroll-lock-smoke.mjs",
    "smoke:anki": "node scripts/anki-mining-smoke.mjs",
    "smoke:anki-template": "node scripts/anki-template-render-smoke.mjs",
    "manual:anki-wikipedia": "node scripts/manual/anki-wikipedia-smoke.mjs",
    "manual:audio-csp-fallback": "node scripts/manual/audio-csp-fallback-smoke.mjs",
    "manual:audio-real-page": "node scripts/manual/audio-real-page-smoke.mjs",
    "manual:bookwalker-carousel": "node scripts/manual/bookwalker-carousel-overflow-smoke.mjs",
    "manual:bunpro-live": "node scripts/manual/bunpro-live-smoke.mjs",
    "manual:audio-newtab": "node scripts/manual/audio-newtab-smoke.mjs",
    "manual:audio-popover": "node scripts/manual/audio-popover-smoke.mjs",
    "smoke:feedback": "node scripts/feedback-smoke.mjs",
    "prepare:electron": "node scripts/ensure-electron-runtime.mjs",
    "smoke:gaming": "npm run prepare:electron && npm run build:gaming && node scripts/gaming-app-smoke.mjs",
    "manual:academy-park": "node scripts/manual/academy-park-browser.mjs",
    "manual:academy-home": "node scripts/manual/academy-home-browser.mjs",
    "manual:academy-bookshop": "node scripts/manual/bookshop-world-browser.mjs",
    "manual:academy-profile": "node scripts/manual/profile-portrait-browser.mjs",
    "smoke:hosted-settings": "node scripts/hosted-settings-self-enhancement-smoke.mjs",
    "manual:jiten-newtab": "node scripts/manual/jiten-newtab-smoke.mjs",
    "smoke:jiten-keyless-definition": "node scripts/jiten-keyless-definition-smoke.mjs",
    "manual:japanese-sites": "node scripts/manual/japanese-site-language-smoke.mjs",
    "manual:keyless-jiten-detail": "node scripts/manual/keyless-jiten-detail-smoke.mjs",
    "smoke:onboarding-popover": "node scripts/onboarding-popover-smoke.mjs",
    "smoke:furigana-local-default": "node scripts/furigana-local-default-smoke.mjs",
    "smoke:definition-sources": "node scripts/definition-sources-playwright-smoke.mjs",
    "manual:keyless-popover": "node scripts/manual/keyless-word-popover-smoke.mjs",
    "smoke:late-content": "node scripts/late-content-smoke.mjs",
    "smoke:grading-provider": "node scripts/grading-provider-popover-smoke.mjs",
    "smoke:google-search-reader": "node scripts/google-search-reader-smoke.mjs",
    "manual:live-browser": "node scripts/manual/live-browser-smoke.mjs",
    "smoke:mobile-docs": "node scripts/mobile-docs-regression-smoke.mjs",
    "smoke:offline-study": "node scripts/offline-study-smoke.mjs",
    "smoke:ocr-provider-matrix": "node scripts/ocr-provider-matrix.mjs",
    "smoke:p0": "npm run smoke:feedback && npm run smoke:pdf-reader && npm run smoke:google-search-reader",
    "manual:youtube-sidebar-layout": "node scripts/manual/youtube-sidebar-layout-matrix.mjs",
    "manual:youtube-sidebar-resize-profile": "node scripts/manual/youtube-sidebar-resize-profile.mjs",
    "smoke:popover-headword-furigana": "node scripts/popover-headword-furigana-smoke.mjs",
    "manual:popover-actions": "node scripts/manual/popover-action-pills-smoke.mjs",
    "manual:youtube-performance": "node scripts/manual/youtube-performance-profile.mjs",
    "smoke:youtube-ruby-proof": "node scripts/youtube-ruby-coverage-proof.mjs",
    "smoke:youtube-title-recycler": "node scripts/youtube-title-recycler-smoke.mjs",
    "smoke:enrichment-concurrency": "node scripts/enrichment-concurrency-smoke.mjs",
    "smoke:pitch-underline": "node scripts/pitch-underline-smoke.mjs",
    "smoke:pdf-reader": "node scripts/pdf-reader-smoke.mjs",
    "manual:reader-sites": "node scripts/manual/reader-sites-smoke.mjs",
    "smoke:release": "npm run smoke:p0 && npm run smoke:layout-regressions && npm run smoke:offline-study && npm run smoke:furigana-local-default && npm run smoke:youtube-controls-wake && npm run smoke:youtube-title-recycler && npm run smoke:study-flow-stability",
    "smoke:nightly": "node scripts/run-nightly-smokes.mjs",
    "smoke:reddit-chrome": "node scripts/reddit-chrome-furigana-smoke.mjs",
    "smoke:layout-regressions": "npm run smoke:chip-mirror && npm run smoke:constrained-gate && npm run smoke:reddit-chrome",
    "manual:settings-layout": "node scripts/manual/settings-layout-smoke.mjs",
    "manual:subtitle-live-sites": "node scripts/manual/subtitle-live-video-site-smoke.mjs",
    "manual:subtitle-live-compat": "YOMU_LIVE_VIDEO_SITE_SET=compat node scripts/manual/subtitle-live-video-site-smoke.mjs",
    "smoke:study-personas": "node scripts/study-personas-smoke.mjs",
    "smoke:study-flow-stability": "node scripts/study-flow-stability-smoke.mjs",
    "manual:subtitles": "node scripts/manual/subtitle-player-smoke.mjs",
    "smoke:subtitle-network": "node scripts/subtitle-network-resilience-smoke.mjs",
    "manual:youtube": "node scripts/manual/youtube-feature-smoke.mjs",
    "manual:youtube-auto-translation": "node scripts/manual/youtube-auto-translation-smoke.mjs",
    "smoke:youtube-controls-wake": "node scripts/youtube-controls-wake-smoke.mjs",
    "manual:extension-boot": "node scripts/manual/extension-boot-smoke.mjs",
    "smoke:youtube-dom-safe": "node scripts/youtube-dom-safe-smoke.mjs",
    "manual:youtube-fullscreen": "node scripts/manual/youtube-fullscreen-smoke.mjs",
    "manual:youtube-homepage-performance": "node scripts/manual/youtube-homepage-performance-profile.mjs",
    "manual:youtube-real-dom-instability": "node scripts/manual/youtube-real-dom-instability-smoke.mjs",
    "test": "vitest run",
    "test:academy": "vitest run --config config/vite/academy.config.ts",
    "test:ci": "node scripts/run-ci-suite.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-userscript.cjs",
    "start:gaming": "npm run build:gaming && electron dist-gaming/electron/main.cjs",
    "smoke:constrained-gate": "node scripts/constrained-row-mirror-gate-smoke.mjs",
    "smoke:chip-mirror": "node scripts/chip-mirror-fidelity-smoke.mjs",
    "manual:live-furigana-layout": "node scripts/manual/live-furigana-layout-smoke.mjs",
    "manual:lookup-popover-strip": "node scripts/manual/lookup-popover-strip-smoke.mjs",
    "smoke:transcript-drawer": "node scripts/transcript-drawer-row-smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@electron/packager": "^18.4.4",
    "@types/node": "^25.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.5",
    "fake-indexeddb": "^6.2.5",
    "fallow": "^2.88.3",
    "jsdom": "^24.0.0",
    "playwright": "^1.56.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-monkey": "^3.5.1",
    "vitepress": "^1.6.4",
    "vitest": "^1.3.1",
    "vue": "^3.5.34"
  }
}
