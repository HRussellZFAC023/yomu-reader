  "explanation": {
    "order": 5,
    "recap": "The last consolidation gave you numbers, counters and the confidence to read a short Japanese message. Now the sounds you already know gain a second written wardrobe: katakana.",
    "intro": "Katakana writes the same Japanese sound system you already know. Today the work is visual: learn the shapes in the five vowel signs, then let a familiar word give each shape a job. Read in short beats; one katakana normally carries one sound.",
    "grammarPoints": [
      {
        "pattern": "カタカナ 一字 = 一つの 音",
        "nameJa": "カタカナの 音",
        "meaning": "one katakana sign usually holds one Japanese sound",
        "explanation": "Katakana is not an English spelling system. Read each sign in order and give it one clean Japanese beat. Long words are not rushed: カ・メ・ラ is ka-me-ra. When a word has a long bar, stretch the vowel before it gently.",
        "watchFor": "Do not guess from English spelling. Trust the katakana sounds on the page.",
        "commonError": "Trying to give one sign two English sounds. Keep a single beat for each sign.",
        "examples": [
          {
            "ja": "アイス",
            "reading": "アイス",
            "en": "ice cream",
            "note": "Read the signs one by one."
          },
          {
            "ja": "エア",
            "reading": "エア",
            "en": "air",
            "note": "The word is built from steady beats."
          }
        ]
      },
      {
        "pattern": "小さい しるし",
        "nameJa": "だくてん・半だくてん",
        "meaning": "small marks can change a consonant sound",
        "explanation": "Some katakana gain two small dakuten strokes, and the ハ row can gain a small handakuten circle. These marks are not decoration. They change the sound, so keep them small but visible.",
        "watchFor": "The marks sit at the upper right of the character they change.",
        "commonError": "Writing the mark in the middle of the character, where it becomes hard to read.",
        "examples": [
          {
            "ja": "カ → ガ",
            "reading": "か → が",
            "en": "ka becomes ga",
            "note": "Two small strokes voice the sound."
          },
          {
            "ja": "ハ → パ",
            "reading": "は → ぱ",
            "en": "ha becomes pa",
            "note": "The small circle makes pa."
          }
        ]
      }
    ]
  },
