{
  "schema": "yomu-academy.minna-chapter-reference.v1",
  "note": "Public reference scope for Minna no Nihongo Shokyu I (ch 1-25) and II (ch 26-50). Chapter NUMBERS per week are anchored to real worksheet titles in the source ledger; the grammar-point labels here are widely-published textbook facts used to name that scope. Grammar strings that also appear verbatim in a week's worksheet titles are treated as `anchored`; otherwise `reference`.",
  "jlptBandByChapter": { "1-11": "N5", "12-25": "N5", "26-36": "N4" },
  "chapters": {
    "1": { "theme": "Introductions and identity", "jlpt": "N5", "grammar": ["NはNです", "question particle か", "も (also)", "の (X of Y)"], "vocab": "greetings, countries, occupations, family names", "conversation": "はじめまして" },
    "2": { "theme": "This, that, and things", "jlpt": "N5", "grammar": ["これ・それ・あれ", "この・その・あの＋N", "そうです / そうですか", "の (possession)"], "vocab": "everyday objects, これから おせわに なります", "conversation": "これから おせわに なります" },
    "3": { "theme": "Places and prices", "jlpt": "N5", "grammar": ["ここ・そこ・あそこ・どこ", "Nは 場所です", "いくらですか (prices)"], "vocab": "shops, floors, prices, これを ください", "conversation": "これを ください" },
    "4": { "theme": "Time and daily schedule", "jlpt": "N5", "grammar": ["〜時〜分", "〜から〜まで", "verb ます/ません/ました/ませんでした", "ね"], "vocab": "times, days, daily verbs" },
    "5": { "theme": "Going places", "jlpt": "N5", "grammar": ["いきます・きます・かえります", "〜へ (direction)", "〜で (vehicle)", "〜と (with person)", "いつ"], "vocab": "transport, destinations" },
    "6": { "theme": "Doing things and inviting", "jlpt": "N5", "grammar": ["〜を (object) verb", "〜を します", "〜ませんか (invite)", "〜ましょう", "なにか・どこかで"], "vocab": "food, activities" },
    "7": { "theme": "Tools, giving and receiving", "jlpt": "N5", "grammar": ["〜で (means/tool)", "〜に あげます", "〜に もらいます", "もう / まだ"], "vocab": "tools, gifts, family" },
    "8": { "theme": "Describing with adjectives", "jlpt": "N5", "grammar": ["い-adjectives", "な-adjectives", "とても / あまり", "〜が (but)", "どんな"], "vocab": "adjectives, opinions", "conversation": "そろそろ しつれいします" },
    "9": { "theme": "Likes, skills and reasons", "jlpt": "N5", "grammar": ["〜が すきです / じょうずです", "〜が わかります / あります", "〜から (reason)", "どうして"], "vocab": "preferences, abilities", "conversation": "ざんねんです" },
    "10": { "theme": "Existence and location", "jlpt": "N5", "grammar": ["〜が あります / います", "location words 上・下・前・なか", "〜や〜（など）"], "vocab": "places, positions" },
    "11": { "theme": "Counters and quantities", "jlpt": "N5", "grammar": ["counters 〜つ・〜人・〜まい・〜だい・〜かい", "〜に〜かい (frequency)", "duration 〜間"], "vocab": "numbers, counters", "conversation": "これ おねがいします" },
    "12": { "theme": "Comparisons and past states", "jlpt": "N5", "grammar": ["past of adjectives/nouns 〜でした / 〜かったです", "〜より", "〜ほうが", "〜のなかで いちばん", "どちら"], "vocab": "comparison, seasons" },
    "13": { "theme": "Wants and purpose", "jlpt": "N5", "grammar": ["〜が ほしいです", "〜たいです", "〜へ 〜に いきます (purpose)"], "vocab": "wishes, sightseeing" },
    "14": { "theme": "Requests and ongoing action", "jlpt": "N5", "grammar": ["て-form", "〜てください", "〜ています (progressive)", "〜ましょうか"], "vocab": "actions, help" },
    "15": { "theme": "Permission and states", "jlpt": "N5", "grammar": ["〜てもいいです (permission)", "〜てはいけません (prohibition)", "〜ています (occupation/habit)"], "vocab": "rules, jobs" },
    "16": { "theme": "Connecting actions", "jlpt": "N5", "grammar": ["〜て、〜て (sequence)", "〜てから", "adjective/noun て-connection", "どうやって"], "vocab": "procedures, order" },
    "17": { "theme": "Obligations and negatives", "jlpt": "N5", "grammar": ["ない-form", "〜ないでください", "〜なければなりません", "〜なくてもいいです"], "vocab": "health, rules" },
    "18": { "theme": "Ability and before doing", "jlpt": "N5", "grammar": ["dictionary form", "〜ことが できます (ability)", "〜こと (nominalizer)", "〜まえに", "ぜひ"], "vocab": "hobbies, skills" },
    "19": { "theme": "Experiences and change", "jlpt": "N5", "grammar": ["〜たことが あります (experience)", "〜たり、〜たり します", "〜くなります / 〜になります (change)"], "vocab": "experiences, plain past た-form (た形)", "conversation": "ダイエットは あしたから します" },
    "20": { "theme": "Casual / plain speech", "jlpt": "N5", "grammar": ["plain form (常体)", "casual conversation", "plain-form questions"], "vocab": "casual expressions" },
    "21": { "theme": "Opinions and quoting", "jlpt": "N5", "grammar": ["〜と おもいます", "〜と いいます (quote)", "〜でしょう？", "〜について"], "vocab": "opinions, news", "conversation": "わたしも そう おもいます" },
    "22": { "theme": "Noun-modifying clauses", "jlpt": "N4", "grammar": ["連体修飾 (relative clauses)", "verb-clause ＋ N", "〜とき の N"], "vocab": "descriptions, clothes" },
    "23": { "theme": "When and whenever (とき / と)", "jlpt": "N4", "grammar": ["〜とき (when)", "〜と (natural/whenever result)"], "vocab": "directions, machines" },
    "24": { "theme": "Doing favours", "jlpt": "N4", "grammar": ["〜てくれます", "〜てあげます", "〜てもらいます", "〜てくれませんか"], "vocab": "help, kindness" },
    "25": { "theme": "Conditionals たら / ても", "jlpt": "N4", "grammar": ["〜たら (conditional)", "〜ても (even if)", "plain past ＋ら"], "vocab": "life events, hypotheticals" },
    "26": { "theme": "Explaining with んです", "jlpt": "N4", "grammar": ["〜んです (explanation)", "〜ていただけませんか (polite request)"], "vocab": "reasons, situations" },
    "27": { "theme": "Potential and contrast", "jlpt": "N4", "grammar": ["potential form 〜られます (can)", "〜しか 〜ない", "〜は (contrast)", "みえます / きこえます"], "vocab": "ability, senses", "conversation": "〜しか / N は making contrast" },
    "28": { "theme": "Parallel actions and reasons", "jlpt": "N4", "grammar": ["〜ながら (simultaneous)", "〜ています (habitual)", "〜し、〜し (multiple reasons)"], "vocab": "routines, multitasking" },
    "29": { "theme": "States in effect and completion", "jlpt": "N4", "grammar": ["〜ている (resultant state, intransitive)", "〜てしまいます / 〜てしまいました (completion/regret)"], "vocab": "appearance, accidents", "conversation": "わたしの失敗 / 〜てしまいました" },
    "30": { "theme": "Prepared states", "jlpt": "N4", "grammar": ["〜てあります (resultant state, transitive)", "〜ておきます (preparation)", "〜まま"], "vocab": "preparation, arrangements", "conversation": "日本で一番 / 〜ておく" },
    "31": { "theme": "Intentions and plans", "jlpt": "N4", "grammar": ["volitional form (意向形)", "〜（よ）うと 思っています", "〜つもりです", "〜予定です"], "vocab": "plans, intentions", "conversation": "volitional / 〜ようと思う" },
    "32": { "theme": "Advice and probability", "jlpt": "N4", "grammar": ["〜ほうが いいです (advice)", "〜でしょう (probability)", "〜かもしれません"], "vocab": "advice, weather, health" },
    "33": { "theme": "Commands, signs and reporting", "jlpt": "N4", "grammar": ["imperative / prohibitive (命令形・〜な)", "〜と 書いてあります / 〜と 読みます / 〜という 意味です", "〜と 言っていました", "〜と 伝えていただけませんか"], "vocab": "signs, notices, messages" },
    "34": { "theme": "Doing as instructed / sequence", "jlpt": "N4", "grammar": ["〜とおりに (as / the way)", "〜たあとで", "〜て / 〜ないで (with/without doing)"], "vocab": "instructions, cooking" },
    "35": { "theme": "Conditionals ば / なら", "jlpt": "N4", "grammar": ["〜ば (conditional)", "〜なら (topic conditional / suggestion)", "〜ほど"], "vocab": "advice, suggestions", "conversation": "noun 〜なら making suggestions" },
    "36": { "theme": "Goals and ように", "jlpt": "N4", "grammar": ["〜ように (purpose/goal)", "〜ようになります (change of ability)", "〜ようにしています (habitual effort)"], "vocab": "goals, effort, health", "conversation": "動物の目 / 〜ように・ないように" }
  }
}
