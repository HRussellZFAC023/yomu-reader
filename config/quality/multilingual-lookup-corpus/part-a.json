    "sentences": [
      { "id": "zh-01", "text": "星期一早上，玛丽亚很早就去了市场。", "contentWords": ["星期一", "早上", "玛丽亚", "很早", "去了", "市场"] },
      { "id": "zh-02", "text": "她买了新鲜面包、两个苹果和一瓶水。", "contentWords": ["买了", "新鲜", "面包", "两个", "苹果", "一瓶", "水"] },
      { "id": "zh-03", "text": "摊主向她问好，还问起她的家人。", "contentWords": ["摊主", "问好", "问起", "家人"] },
      { "id": "zh-04", "text": "玛丽亚说，她的孩子们正在家里学习。", "contentWords": ["玛丽亚", "说", "孩子们", "家里", "学习"] },
      { "id": "zh-05", "text": "买完东西后，她穿过了公园。", "contentWords": ["买完", "东西", "穿过", "公园"] },
      { "id": "zh-06", "text": "一只小狗正在湖边玩耍。", "contentWords": ["小狗", "湖边", "玩耍"] },
      { "id": "zh-07", "text": "她坐在树下，读了一本新书。", "contentWords": ["坐", "树下", "读了", "新书"] },
      { "id": "zh-08", "text": "开始下雨时，她打开了蓝色雨伞。", "contentWords": ["开始", "下雨", "打开", "蓝色", "雨伞"] },
      { "id": "zh-09", "text": "晚饭前，她坐公交车回了家。", "contentWords": ["晚饭", "坐", "公交车", "回了", "家"] },
      { "id": "zh-10", "text": "晚上，全家人一起吃饭，聊起了今天发生的事。", "contentWords": ["晚上", "全家人", "一起", "吃饭", "聊起", "今天", "发生", "事"] }
    ]
  },
  {
