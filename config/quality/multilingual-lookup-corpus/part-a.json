    "sentences": [
      { "id": "da-01", "text": "Mandag morgen gik Maria tidligt på markedet.", "contentWords": ["Mandag", "morgen", "gik", "Maria", "tidligt", "markedet"] },
      { "id": "da-02", "text": "Hun købte frisk brød, to æbler og en flaske vand.", "contentWords": ["købte", "frisk", "brød", "to", "æbler", "flaske", "vand"] },
      { "id": "da-03", "text": "Sælgeren hilste på hende og spurgte til hendes familie.", "contentWords": ["Sælgeren", "hilste", "spurgte", "familie"] },
      { "id": "da-04", "text": "Maria sagde, at hendes børn studerede hjemme.", "contentWords": ["Maria", "sagde", "børn", "studerede", "hjemme"] },
      { "id": "da-05", "text": "Efter indkøbene gik hun gennem parken.", "contentWords": ["indkøbene", "gik", "parken"] },
      { "id": "da-06", "text": "En lille hund legede nær søen.", "contentWords": ["lille", "hund", "legede", "søen"] },
      { "id": "da-07", "text": "Hun satte sig under et træ og læste en ny bog.", "contentWords": ["satte", "træ", "læste", "ny", "bog"] },
      { "id": "da-08", "text": "Da det begyndte at regne, slog hun sin blå paraply op.", "contentWords": ["begyndte", "regne", "slog", "blå", "paraply"] },
      { "id": "da-09", "text": "Før aftensmaden tog hun bussen hjem.", "contentWords": ["aftensmaden", "tog", "bussen", "hjem"] },
      { "id": "da-10", "text": "Om aftenen spiste hele familien sammen og talte om dagen.", "contentWords": ["aftenen", "spiste", "familien", "sammen", "talte", "dagen"] }
    ]
  },
  {
    "language": "nl",
    "source": {
