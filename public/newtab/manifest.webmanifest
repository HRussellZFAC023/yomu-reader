{
  "id": "./",
  "name": "よむ — Language Reader & Study",
  "short_name": "よむ",
  "description": "An offline-first dictionary and Study companion for 33 learning targets, local cards, and supported connected services.",
  "lang": "en",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#181b20",
  "theme_color": "#181b20",
  "categories": ["education", "productivity"],
  "shortcuts": [
    {
      "name": "Study",
      "short_name": "Study",
      "description": "Continue your offline-ready review queue.",
      "url": "./?mode=word"
    },
    {
      "name": "Library",
      "short_name": "Library",
      "description": "Search and browse cards in your selected learning target.",
      "url": "./?mode=search"
    },
    {
      "name": "Stats",
      "short_name": "Stats",
      "description": "Open your combined learning progress.",
      "url": "./?mode=stats"
    }
  ],
