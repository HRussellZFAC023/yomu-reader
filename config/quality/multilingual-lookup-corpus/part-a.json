    "sentences": [
      { "id": "nl-01", "text": "Op maandag ging Maria vroeg naar de markt.", "contentWords": ["maandag", "ging", "Maria", "vroeg", "markt"] },
      { "id": "nl-02", "text": "Zij kocht vers brood, twee appels en een fles water.", "contentWords": ["kocht", "vers", "brood", "twee", "appels", "fles", "water"] },
      { "id": "nl-03", "text": "De verkoper groette haar en vroeg naar haar familie.", "contentWords": ["verkoper", "groette", "vroeg", "familie"] },
      { "id": "nl-04", "text": "Maria zei dat haar kinderen thuis studeerden.", "contentWords": ["Maria", "zei", "kinderen", "thuis", "studeerden"] },
      { "id": "nl-05", "text": "Na het winkelen liep ze door het park.", "contentWords": ["winkelen", "liep", "park"] },
      { "id": "nl-06", "text": "Een kleine hond speelde bij het meer.", "contentWords": ["kleine", "hond", "speelde", "meer"] },
      { "id": "nl-07", "text": "Ze ging onder een boom zitten en las een nieuw boek.", "contentWords": ["ging", "boom", "zitten", "las", "nieuw", "boek"] },
      { "id": "nl-08", "text": "Toen het begon te regenen, opende ze haar blauwe paraplu.", "contentWords": ["begon", "regenen", "opende", "blauwe", "paraplu"] },
      { "id": "nl-09", "text": "Voor het avondeten ging ze met de bus naar huis.", "contentWords": ["avondeten", "ging", "bus", "huis"] },
      { "id": "nl-10", "text": "'s Avonds at het hele gezin samen en praatte over de dag.", "contentWords": ["Avonds", "at", "gezin", "samen", "praatte", "dag"] }
    ]
  },
