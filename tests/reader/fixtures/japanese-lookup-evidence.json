    "sentences": [
      {
        "id": "ja-01",
        "text": "月曜日の朝、マリアは早く市場へ行きました。",
        "contentWords": [
          "月曜日",
          "朝",
          "マリア",
          "早く",
          "市場",
          "行きました"
        ]
      },
      {
        "id": "ja-02",
        "text": "新鮮なパンとりんごを二つ、それに水を一本買いました。",
        "contentWords": [
          "新鮮",
          "パン",
          "りんご",
          "二つ",
          "水",
          "一本",
          "買いました"
        ]
      },
      {
        "id": "ja-03",
        "text": "店員は彼女に挨拶し、家族のことを尋ねました。",
        "contentWords": [
          "店員",
          "彼女",
          "挨拶",
          "家族",
          "尋ねました"
        ]
      },
      {
        "id": "ja-04",
        "text": "マリアは子どもたちが家で勉強していると話しました。",
        "contentWords": [
          "マリア",
          "子どもたち",
          "家",
          "勉強",
          "話しました"
        ]
      },
      {
        "id": "ja-05",
        "text": "買い物のあと、彼女は公園を歩きました。",
        "contentWords": [
          "買い物",
          "彼女",
          "公園",
          "歩きました"
        ]
      },
      {
        "id": "ja-06",
        "text": "小さな犬が湖の近くで遊んでいました。",
        "contentWords": [
          "小さな",
          "犬",
          "湖",
          "近く",
          "遊んでいました"
        ]
      },
      {
        "id": "ja-07",
        "text": "彼女は木の下に座り、新しい本を読みました。",
        "contentWords": [
          "彼女",
          "木",
          "下",
          "座り",
          "新しい",
          "本",
          "読みました"
        ]
      },
      {
        "id": "ja-08",
        "text": "雨が降り始めると、青い傘を開きました。",
        "contentWords": [
          "雨",
          "降り始める",
          "青い",
          "傘",
          "開きました"
        ]
      },
      {
        "id": "ja-09",
        "text": "夕食前にバスで家へ帰りました。",
        "contentWords": [
          "夕食",
          "バス",
          "家",
          "帰りました"
        ]
      },
      {
        "id": "ja-10",
        "text": "夜は家族全員で食事をし、その日のことを話しました。",
        "contentWords": [
          "夜",
          "家族",
          "全員",
          "食事",
          "その日",
          "話しました"
        ]
      }
    ]
  },
