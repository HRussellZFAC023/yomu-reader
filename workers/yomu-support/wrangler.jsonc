{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yomu-support",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // Cloudflare's own record of the running version, reported by the health
  // endpoint so a deploy can be identified without an API call.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [
    {
      "pattern": "support.yomureader.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "SUPPORT_BANNER_ENABLED": "true",
    // Forecast and support accounting use canonical GBP. Incoming payer amounts
    // remain in their native currency; converted GBP is stored separately.
    "SUPPORT_BASE_CURRENCY": "GBP",
    "SUPPORT_DAILY_BUDGET_GBP": "10",
    // The goal always derives from operating-forecast.json. The current exact
    // forecast is £10.20; the public bar rounds it to £10 while accounting
    // retains £10.20.
    "SUPPORT_DONATIONS_TODAY_GBP": "0",
    "SUPPORT_DONATIONS_THIS_MONTH_GBP": "0",
    "SUPPORT_ESTIMATED_DAILY_COST_GBP": "0",
    "SUPPORT_SUCCESS_URL": "https://yomureader.com/support?donation=success",
    "SUPPORT_CANCEL_URL": "https://yomureader.com/support?donation=cancelled",
    // Public provider links. A link is exposed only when it uses HTTPS on the
    // provider's exact hostname (or www form), SUPPORT_DB is bound, and every
    // required provider secret is present in the Worker environment. Empty or
    // unready = hidden.
    // Stripe stays server-side via /donate and requires live Checkout readiness.
    "SUPPORT_PROVIDER_KOFI_URL": "https://ko-fi.com/yomureader",
    "SUPPORT_PROVIDER_BMAC_URL": "",
    "SUPPORT_PROVIDER_PAYPAL_URL": "",
    "SUPPORT_PROVIDER_PATREON_URL": "https://patreon.com/yomureader",
    // Patreon Member webhooks report cumulative income in the campaign's
    // currency rather than carrying a transaction currency per event.
    "PATREON_CAMPAIGN_ID": "",
    "PATREON_CAMPAIGN_CURRENCY": "GBP"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": [
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "KOFI_WEBHOOK_SECRET",
      "PATREON_WEBHOOK_SECRET",
      "PAYMENT_INGRESS_TOKEN",
      "ACADEMY_DELIVERY_ALERT_EMAIL"
    ]
  },
  "triggers": {
    // A PII-free reconciliation check reports paid events whose Academy code
    // was not delivered. Webhook failures are still reported immediately.
    "crons": ["*/15 * * * *"]
  },
  "send_email": [
    {
      "name": "ACADEMY_CODE_EMAIL",
      "allowed_sender_addresses": ["academy@notifications.yomureader.com"]
    }
  ],
  // Requests still require the shared bearer credential even though transport
  // uses a private Service binding.
  "services": [
    {
      "binding": "ACADEMY_PAYMENT_INGRESS",
      "service": "yomu-academy"
    }
  ],
  "d1_databases": [
    {
      "binding": "SUPPORT_DB",
      "database_name": "yomu-support",
      "database_id": "c39e8f5c-e6fc-44e0-9b0c-987cde5bcd3c",
      "migrations_dir": "migrations"
    }
  ],
  // SUPPORT_KV holds only the daily FX-rate cache (24h). Verified provider
  // donation events and aggregates live in SUPPORT_DB for atomic idempotency.
  "kv_namespaces": [
    {
      "binding": "SUPPORT_KV",
      "id": "8d82282d8e3542a5bc37ef667a8ffe70"
    }
  ]
}
