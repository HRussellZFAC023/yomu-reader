    "sentences": [
      { "id": "yue-01", "text": "星期一朝早，瑪利亞一早去咗街市。", "contentWords": ["星期一", "朝早", "瑪利亞", "一早", "去咗", "街市"] },
      { "id": "yue-02", "text": "佢買咗新鮮麵包、兩個蘋果同一樽水。", "contentWords": ["買咗", "新鮮", "麵包", "兩個", "蘋果", "一樽", "水"] },
      { "id": "yue-03", "text": "檔主同佢打招呼，又問起佢屋企人。", "contentWords": ["檔主", "打招呼", "問起", "屋企人"] },
      { "id": "yue-04", "text": "瑪利亞話佢啲細路喺屋企讀緊書。", "contentWords": ["瑪利亞", "細路", "屋企", "讀緊書"] },
      { "id": "yue-05", "text": "買完嘢之後，佢行過公園。", "contentWords": ["買完嘢", "行過", "公園"] },
      { "id": "yue-06", "text": "一隻小狗喺湖邊玩緊。", "contentWords": ["小狗", "湖邊", "玩緊"] },
      { "id": "yue-07", "text": "佢坐喺樹下，睇一本新書。", "contentWords": ["坐", "樹下", "睇", "新書"] },
      { "id": "yue-08", "text": "開始落雨嗰陣，佢擔起咗把藍色雨遮。", "contentWords": ["開始", "落雨", "擔起", "藍色", "雨遮"] },
      { "id": "yue-09", "text": "食晚飯之前，佢搭巴士返屋企。", "contentWords": ["食晚飯", "搭巴士", "返屋企"] },
      { "id": "yue-10", "text": "夜晚，全家人一齊食飯，傾返今日發生嘅事。", "contentWords": ["夜晚", "全家人", "一齊", "食飯", "傾返", "今日", "發生", "事"] }
    ]
  },
  {
