    "sentences": [
      { "id": "grc-01", "text": "Τῇ δευτέρᾳ ἡ Μαρία πρωῒ εἰς τὴν ἀγορὰν ἐπορεύθη.", "contentWords": ["δευτέρᾳ", "Μαρία", "πρωῒ", "ἀγορὰν", "ἐπορεύθη"] },
      { "id": "grc-02", "text": "Ἄρτον πρόσφατον, δύο μῆλα καὶ ὕδατος ἀγγεῖον ἠγόρασεν.", "contentWords": ["Ἄρτον", "πρόσφατον", "δύο", "μῆλα", "ὕδατος", "ἀγγεῖον", "ἠγόρασεν"] },
      { "id": "grc-03", "text": "Ὁ πωλητὴς αὐτὴν ἠσπάσατο καὶ περὶ τῶν οἰκείων ἠρώτησεν.", "contentWords": ["πωλητὴς", "ἠσπάσατο", "οἰκείων", "ἠρώτησεν"] },
      { "id": "grc-04", "text": "Ἡ Μαρία εἶπεν ὅτι τὰ τέκνα αὐτῆς οἴκοι ἐμάνθανον.", "contentWords": ["Μαρία", "εἶπεν", "τέκνα", "οἴκοι", "ἐμάνθανον"] },
      { "id": "grc-05", "text": "Μετὰ τὰς ἀγορὰς διὰ τοῦ κήπου ἐβάδισεν.", "contentWords": ["ἀγορὰς", "κήπου", "ἐβάδισεν"] },
      { "id": "grc-06", "text": "Κυνίδιον μικρὸν παρὰ τὴν λίμνην ἔπαιζεν.", "contentWords": ["Κυνίδιον", "μικρὸν", "λίμνην", "ἔπαιζεν"] },
      { "id": "grc-07", "text": "Ὑπὸ δένδρῳ ἐκάθισεν καὶ βιβλίον καινὸν ἀνέγνω.", "contentWords": ["δένδρῳ", "ἐκάθισεν", "βιβλίον", "καινὸν", "ἀνέγνω"] },
      { "id": "grc-08", "text": "Ἐπεὶ ὁ ὑετὸς ἤρξατο, τὸ κυανοῦν σκιάδειον ἀνέπτυξεν.", "contentWords": ["ὑετὸς", "ἤρξατο", "κυανοῦν", "σκιάδειον", "ἀνέπτυξεν"] },
      { "id": "grc-09", "text": "Πρὸ τοῦ δείπνου δημοσίῳ ἅρματι οἴκαδε ἐπανῆλθεν.", "contentWords": ["δείπνου", "δημοσίῳ", "ἅρματι", "οἴκαδε", "ἐπανῆλθεν"] },
      { "id": "grc-10", "text": "Ἑσπέρας ἡ πᾶσα οἰκία ὁμοῦ ἔφαγε καὶ περὶ τῆς ἡμέρας διελέχθη.", "contentWords": ["Ἑσπέρας", "πᾶσα", "οἰκία", "ὁμοῦ", "ἔφαγε", "ἡμέρας", "διελέχθη"] }
    ]
  },
  {
