    "sentences": [
      { "id": "en-01", "text": "On Monday, Maria went to the market early.", "contentWords": ["Monday", "Maria", "went", "market", "early"] },
      { "id": "en-02", "text": "She bought fresh bread, two apples, and a bottle of water.", "contentWords": ["bought", "fresh", "bread", "two", "apples", "bottle", "water"] },
      { "id": "en-03", "text": "The vendor greeted her and asked about her family.", "contentWords": ["vendor", "greeted", "asked", "family"] },
      { "id": "en-04", "text": "Maria said that her children were studying at home.", "contentWords": ["Maria", "said", "children", "studying", "home"] },
      { "id": "en-05", "text": "After shopping, she walked through the park.", "contentWords": ["shopping", "walked", "park"] },
      { "id": "en-06", "text": "A small dog was playing near the lake.", "contentWords": ["small", "dog", "playing", "lake"] },
      { "id": "en-07", "text": "She sat under a tree and read a new book.", "contentWords": ["sat", "tree", "read", "new", "book"] },
      { "id": "en-08", "text": "When it began to rain, she opened her blue umbrella.", "contentWords": ["began", "rain", "opened", "blue", "umbrella"] },
      { "id": "en-09", "text": "She took the bus home before dinner.", "contentWords": ["took", "bus", "home", "dinner"] },
      { "id": "en-10", "text": "In the evening, the whole family ate together and talked about their day.", "contentWords": ["evening", "family", "ate", "together", "talked", "day"] }
    ]
